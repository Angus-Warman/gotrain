package ext

import (
	"encoding/json"
	"html/template"
	"log/slog"
	"net/http"
	"strconv"
)

func WriteJSON(w http.ResponseWriter, v any) {
	w.Header().Set("Content-Type", "application/json")

	w.WriteHeader(200)

	if v != nil {
		_ = json.NewEncoder(w).Encode(v)
	}
}

func ReadJSON(r *http.Request, dst any) error {
	defer r.Body.Close()
	return json.NewDecoder(r.Body).Decode(dst)
}

func ParseID(r *http.Request) (uint, bool) {
	idStr := r.PathValue("id")

	id, err := strconv.ParseUint(idStr, 10, 64)

	if err != nil {
		return 0, false
	}

	return uint(id), true
}

func WriteTemplate(w http.ResponseWriter, tmpl *template.Template, data any) {
	err := tmpl.Execute(w, data)

	if err != nil {
		WriteError(w, err)
	}
}

func WriteError(w http.ResponseWriter, err error) {
	slog.Error("request error", "err", err)
	w.WriteHeader(500)
	w.Write([]byte(err.Error()))
}

func WriteMessage(w http.ResponseWriter, status int, message string) {
	if status >= 400 {
		slog.Warn("response", slog.Int("status", status), slog.String("message", message))
	} else {
		slog.Debug("response", slog.Int("status", status), slog.String("message", message))
	}

	w.WriteHeader(status)
	w.Write([]byte(message))
}
