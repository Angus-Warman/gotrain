package main

import (
	"context"
	"fmt"
	"log"
	"net/http"
	"os"
	"os/signal"
	"path/filepath"
	"syscall"
	"time"

	"gorm.io/driver/sqlite"
	"gorm.io/gorm"

	"{{.projectName}}/gen"
)

func getEnv(key, fallback string) string {
	value := os.Getenv(key)

	if value == "" {
		return fallback
	}

	return value
}

func main() {
	dbPath := getEnv("DB_PATH", "./data/data.db")
	port := getEnv("PORT", "8080")
	addr := fmt.Sprintf("%s:", port)

	db, err := openDB(dbPath)

	if err != nil {
		log.Fatalf("failed to open db: %v", err)
	}

	mux := http.NewServeMux()

	gen.AddHandlers(mux, db)

	mux.Handle("/", http.FileServer(http.Dir("./public")))

	modified := logging(mux)

	srv := &http.Server{
		Addr:              addr,
		Handler:           modified,
		ReadTimeout:       5 * time.Second,
		IdleTimeout:       60 * time.Second,
		ReadHeaderTimeout: 2 * time.Second,
	}

	log.Printf("listening on http://localhost:%s", port)

	ListenUntilShutdown(srv)
}

func openDB(dbPath string) (*gorm.DB, error) {
	err := os.MkdirAll(filepath.Dir(dbPath), 0770)

	if err != nil {
		return nil, err
	}

	db, err := gorm.Open(sqlite.Open(dbPath), &gorm.Config{})

	if err != nil {
		return nil, err
	}

	return db, nil
}

func logging(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()
		next.ServeHTTP(w, r)
		log.Printf("%s %s (%s)", r.Method, r.URL.Path, time.Since(start))
	})
}

func ListenUntilShutdown(srv *http.Server) {
	signalChannel := make(chan os.Signal, 1)
	signal.Notify(signalChannel, os.Interrupt, syscall.SIGTERM)
	defer signal.Stop(signalChannel)

	go func() {
		err := srv.ListenAndServe()

		if err != nil && err != http.ErrServerClosed {
			log.Fatalln(err)
		}
	}()

	<-signalChannel
	log.Println("Shutting down...")

	// Give in-flight requests time to complete
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := srv.Shutdown(ctx); err != nil {
		log.Println("Disgraceful shutdown:", err)
		_ = srv.Close()
	}

	log.Println("Goodbye")
}
