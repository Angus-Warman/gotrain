package gen

import (
	"net/http"

	"gorm.io/gorm"

    {{- range .modelNames}}
    "{{ $.projectName }}/{{.}}"{{/* Uses $ to access root */}}
    {{- end}}
)

func AddHandlers(mux *http.ServeMux, db *gorm.DB) {
    {{- range .modelNames }}
    {{ . }}.AddHandler(mux, db)
    {{- end}}
}